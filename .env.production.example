# Production env for the Synology deployment. Copy to `.env` on the NAS (next to
# compose.prod.yaml) and fill in. NEVER commit the real .env — it's git-ignored.

# ── Database ───────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD must match the password embedded in DATABASE_URL.
POSTGRES_PASSWORD=        # openssl rand -hex 24
DATABASE_URL=postgresql://postgres:CHANGEME@db:5432/packingdb?schema=public
REDIS_URL=redis://redis:6379

# ── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=               # openssl rand -base64 48
# WebAuthn relying-party identity. rpID is the bare host; ORIGIN is the exact URL.
RP_NAME=Packing List Helper
RP_ID=closet.local
ORIGIN=https://closet.local

# ── Object storage (MinIO) ─────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=         # any non-default value
S3_SECRET_ACCESS_KEY=     # any non-default value
S3_BUCKET=packing-images
S3_FORCE_PATH_STYLE=true

# ── In-app updater (System page) ───────────────────────────────────────────
ADMIN_USERNAME=           # the app username allowed to manage updates
UPDATER_URL=http://updater:9000
UPDATER_TOKEN=            # openssl rand -hex 32
REPO_DIR=/volume1/docker/packing-list-helper
DEPLOY_BRANCH=main
# GITHUB_TOKEN=           # read-only PAT, only if the GitHub repo is private

# ── macvlan (used by compose.prod.yaml to give `edge` a LAN IP) ─────────────
EDGE_IP=192.168.1.50      # free static IP OUTSIDE your DHCP range
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
LAN_PARENT=eth0           # NAS LAN interface: `ip -o link show` (eth0/bond0/ovs_eth0)

# ── Optional AI scan-to-fill (Claude). Leave ANTHROPIC_API_KEY unset. ───────
# CLAUDE_CODE_OAUTH_TOKEN=
# AI_MODEL=claude-sonnet-4-6
