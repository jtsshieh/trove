// EssentialGroup = a reusable, user-owned bundle of essentials (e.g. a "Toiletry
// kit") that can be quick-added to a trip all at once.
model EssentialGroup {
  id String @id @default(cuid())

  name  String
  order String

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items      EssentialGroupItem[]
  tripGroups TripEssentialGroup[]

  @@map("essential_groups")
}

// TripEssentialGroup = a sub-group on one trip — created ad-hoc, or materialized
// from a premade EssentialGroup template. Provisions point at it. Deleting it
// ungroups its provisions (SetNull) rather than removing them.
model TripEssentialGroup {
  id String @id @default(cuid())

  name  String
  order String

  tripId String @map("trip_id")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  sourceGroupId String?         @map("source_group_id")
  sourceGroup   EssentialGroup? @relation(fields: [sourceGroupId], references: [id], onDelete: SetNull)

  provisions EssentialProvision[]

  @@map("trip_essential_groups")
}

model EssentialGroupItem {
  id String @id @default(cuid())

  order String

  groupId String         @map("group_id")
  group   EssentialGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Polymorphic item ref — exactly one set, matching `kind` (DB CHECK + service).
  kind EssentialKind

  bathroomVariantId String?          @map("bathroom_variant_id")
  bathroomVariant   BathroomVariant? @relation(fields: [bathroomVariantId], references: [id], onDelete: Cascade)

  electronicId String?     @map("electronic_id")
  electronic   Electronic? @relation(fields: [electronicId], references: [id], onDelete: Cascade)

  documentId String?   @map("document_id")
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("essential_group_items")
}
