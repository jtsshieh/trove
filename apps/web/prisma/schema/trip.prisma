enum TripMode {
  Provision
  Pack
  Audit
}

model Trip {
  id String @id @default(cuid())

  name String

  start DateTime
  end   DateTime

  mode TripMode @default(Provision)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clothingProvisions  ClothingProvision[]
  essentialProvisions EssentialProvision[]
  containerProvisions ContainerProvision[]
  luggageProvisions   LuggageProvision[]
  tripOutfits         TripOutfit[]
  tripEssentialGroups TripEssentialGroup[]
  dayNotes            TripDayNote[]
  clothingBrings      TripClothingBring[]

  @@map("trips")
}

model TripDayNote {
  id String @id @default(cuid())

  day  DateTime
  note String

  tripId String @map("trip_id")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, day])
  @@map("trip_day_notes")
}
