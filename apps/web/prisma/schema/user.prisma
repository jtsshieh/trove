enum UserRole {
  ADMIN
  USER
}

model User {
  id       String   @id @default(cuid())
  username String   @unique
  password String
  role     UserRole @default(USER)

  clothes       Clothing[]
  brands        Brand[]
  clothingTypes ClothingType[]

  bathroomProducts BathroomProduct[]
  bathroomBatches  BathroomBatch[]
  bathroomUnits    BathroomUnit[]
  bathroomTypes    BathroomType[]

  electronics Electronic[]
  documents   Document[]

  luggage    Luggage[]
  containers Container[]

  trips Trip[]

  outfits         Outfit[]
  essentialGroups EssentialGroup[]

  settings UserSettings?

  passkeys Passkey[]

  @@map("users")
}

model Passkey {
  id String @id @default(cuid())

  credentialId String @unique @map("credential_id")

  publicKey Bytes @map("public_key")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  webauthnUserId String @map("webauthn_user_id")
  counter        Int

  transports String

  name String

  createdAt DateTime  @default(now())
  lastUsed  DateTime?

  aaguid String

  @@map("passkeys")
}
