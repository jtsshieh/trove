# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# Generate secrets with:
#   POSTGRES_PASSWORD -> openssl rand -hex 24
#   JWT_SECRET        -> openssl rand -base64 48
# Keep the password in POSTGRES_PASSWORD and DATABASE_URL in sync.

# Password for the Postgres container.
POSTGRES_PASSWORD=

# Connection strings used by the app (and Prisma).
DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5432/closetdb?schema=public
REDIS_URL=redis://localhost:6379

# Secret used to sign session JWTs.
JWT_SECRET=

# Object storage for item images (MinIO locally; any S3 in prod).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=closet-images
S3_FORCE_PATH_STYLE=true

# LLM scan-to-fill via your Claude.ai subscription (run `claude setup-token`).
# Leave ANTHROPIC_API_KEY UNSET — it would take precedence over the OAuth token.
CLAUDE_CODE_OAUTH_TOKEN=
# AI_MODEL=claude-sonnet-4-6

# Background removal model (transformers.js). RMBG-1.4 ships ONNX out of the box;
# point at an ONNX build of briaai/RMBG-2.0 if you have one.
RMBG_MODEL=briaai/RMBG-1.4

# Hanger removal / inpainting (LaMa ONNX, run via onnxruntime-node). The model is
# downloaded once to .cache/lama on first use. Override the source or point at a
# pre-downloaded local file; LAMA_SIZE is the model's spatial input (multiple of 8).
# LAMA_MODEL_URL=https://huggingface.co/Carve/LaMa-ONNX/resolve/main/lama_fp32.onnx
# LAMA_MODEL_PATH=
# LAMA_SIZE=512
# LAMA_IMAGE_DIV=255   # set to 1 if inpainted output looks washed out
