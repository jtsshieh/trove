# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo root: patterns without a leading/internal slash match at any depth
# (so they apply to apps/web, apps/updater, deploy, etc.).

# dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — matches apps/web/.env, deploy/.env, etc.
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (generated client)
apps/web/src/generated/

# production TLS cert/key (mkcert) + updater deploy state — live only on the NAS
deploy/certs/
.deploy-state.json

# e2e test artifacts
apps/web/e2e/*.png
apps/web/e2e/.auth/

# Playwright
test-results/
playwright-report/
blob-report/

# downloaded model weights (LaMa inpainting, etc.)
.cache/

# JetBrains local datasource config (connection settings, not project code)
/.idea/dataSources/
/.idea/dataSources.xml
/.idea/dataSources.local.xml
/.idea/inspectionProfiles/

# local agent tooling
/.agents/
