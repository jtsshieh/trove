enum ProvisionSection {
  Day
  Universal
  Backup
}

// Which app an essentials-board item comes from. The Essentials packing layer is
// item-polymorphic: a provision references exactly one of a bathroom variant, an
// electronic, or a document — matching `kind`.
enum EssentialKind {
  Bathroom
  Electronic
  Document
}

// Carry-on vs checked is decided PER TRIP (the same bag is carry-on on one trip,
// checked on another), so it lives on the provision, not the luggage catalog.
enum LuggageKind {
  CarryOn
  Checked
  Personal
}

model ClothingProvision {
  id String @id @default(cuid())

  section  ProvisionSection @default(Day)
  day      DateTime?
  dayOrder String           @map("day_order")

  packed Boolean @default(false)

  containerOrder String? @map("container_order")

  tripId String @map("trip_id")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  clothingId String   @map("clothing_id")
  clothing   Clothing @relation(fields: [clothingId], references: [id], onDelete: Cascade)

  containerProvisionId String?             @map("container_provision_id")
  containerProvision   ContainerProvision? @relation(fields: [containerProvisionId], references: [id], onDelete: Cascade)

  // Direct-to-luggage packing (a "containerless" item): skips a container and is
  // packed straight into a suitcase. `containerless` marks the intent even before a
  // suitcase is chosen; `luggageProvisionId` is the suitcase once assigned. Mutually
  // exclusive with `containerProvisionId` (enforced in the service layer).
  containerless Boolean @default(false)

  luggageProvisionId String?           @map("luggage_provision_id")
  luggageProvision   LuggageProvision? @relation(fields: [luggageProvisionId], references: [id], onDelete: SetNull)
  luggageOrder       String?           @map("luggage_order")

  tripOutfitId String?     @map("trip_outfit_id")
  tripOutfit   TripOutfit? @relation(fields: [tripOutfitId], references: [id], onDelete: SetNull)

  @@index([tripId, section, day])
  @@index([clothingId, tripId])
  @@map("clothing_provisions")
}

model EssentialProvision {
  id String @id @default(cuid())

  section  ProvisionSection @default(Universal)
  day      DateTime?
  dayOrder String           @map("day_order")

  packed Boolean @default(false)

  containerOrder String? @map("container_order")

  tripId String @map("trip_id")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // Polymorphic item ref — exactly one of the three is set, matching `kind`
  // (enforced by a DB CHECK + the service layer).
  kind EssentialKind

  bathroomVariantId String?          @map("bathroom_variant_id")
  bathroomVariant   BathroomVariant? @relation(fields: [bathroomVariantId], references: [id], onDelete: Cascade)

  electronicId String?     @map("electronic_id")
  electronic   Electronic? @relation(fields: [electronicId], references: [id], onDelete: Cascade)

  documentId String?   @map("document_id")
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // The bathroom unit checked out for this trip at the packing stage (optional).
  bathroomUnitId String?       @map("bathroom_unit_id")
  bathroomUnit   BathroomUnit? @relation(fields: [bathroomUnitId], references: [id], onDelete: SetNull)

  containerProvisionId String?             @map("container_provision_id")
  containerProvision   ContainerProvision? @relation(fields: [containerProvisionId], references: [id], onDelete: Cascade)

  // Direct-to-luggage packing (a "containerless" item) — see ClothingProvision.
  containerless Boolean @default(false)

  luggageProvisionId String?           @map("luggage_provision_id")
  luggageProvision   LuggageProvision? @relation(fields: [luggageProvisionId], references: [id], onDelete: SetNull)
  luggageOrder       String?           @map("luggage_order")

  tripEssentialGroupId String?             @map("trip_essential_group_id")
  tripEssentialGroup   TripEssentialGroup? @relation(fields: [tripEssentialGroupId], references: [id], onDelete: SetNull)

  @@index([tripId, section, day])
  @@map("essential_provisions")
}

model ContainerProvision {
  id String @id @default(cuid())

  tripId String @map("trip_id")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  containerId String    @map("container_id")
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)

  clothingProvisions  ClothingProvision[]
  essentialProvisions EssentialProvision[]

  // Manual ordering of containers within the trip's containers board (lexorank).
  tripOrder String? @map("trip_order")

  luggageProvisionId String?           @map("luggage_provision_id")
  luggageProvision   LuggageProvision? @relation(fields: [luggageProvisionId], references: [id], onDelete: Cascade)

  luggageOrder String? @map("luggage_order")

  packed Boolean @default(false)

  @@map("container_provisions")
}

model LuggageProvision {
  id String @id @default(cuid())

  tripId String @map("trip_id")
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  luggageId String  @map("luggage_id")
  luggage   Luggage @relation(fields: [luggageId], references: [id], onDelete: Cascade)

  // Carry-on / checked / personal, decided for this trip (drives liquids compliance).
  kind LuggageKind @default(CarryOn)

  containerProvisions ContainerProvision[]

  // Items packed directly into this suitcase without a container (containerless).
  clothingProvisions  ClothingProvision[]
  essentialProvisions EssentialProvision[]

  // Manual ordering of suitcases within the trip's luggage board (lexorank).
  tripOrder String? @map("trip_order")

  @@map("luggage_provisions")
}
