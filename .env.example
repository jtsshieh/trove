# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# Generate secrets with:
#   POSTGRES_PASSWORD -> openssl rand -hex 24
#   JWT_SECRET        -> openssl rand -base64 48
# Keep the password in POSTGRES_PASSWORD and DATABASE_URL in sync.

# Password for the Postgres container.
POSTGRES_PASSWORD=

# Connection strings used by the app (and Prisma).
DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5432/packingdb?schema=public
REDIS_URL=redis://localhost:6379

# Secret used to sign session JWTs.
JWT_SECRET=
